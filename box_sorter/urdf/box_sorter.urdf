<?xml version="1.0"?>
<robot name="box_sorter">
<link name="base_link"><inertial><origin xyz="0 0 0.35"/><mass value="40.0"/><inertia ixx="3" iyy="5.1" izz="7.5" ixy="0" ixz="0" iyz="0"/></inertial><visual><origin xyz="0 0 0.35"/><geometry><box size="1.2 0.9 0.3"/></geometry><material name="m_base_link"><color rgba="0.9 0.65 0.1 1"/></material></visual><collision><origin xyz="0 0 0.35"/><geometry><box size="1.2 0.9 0.3"/></geometry></collision></link>
<link name="left_wheel"><inertial><origin xyz="0 0 0"/><mass value="3.0"/><inertia ixx="0.0325" iyy="0.0325" izz="0.06" ixy="0" ixz="0" iyz="0"/></inertial><visual><origin xyz="0 0 0"/><geometry><cylinder radius="0.2" length="0.1"/></geometry><material name="m_left_wheel"><color rgba="0.1 0.1 0.1 1"/></material></visual><collision><origin xyz="0 0 0"/><geometry><cylinder radius="0.2" length="0.1"/></geometry></collision></link>
<joint name="left_wheel_joint" type="continuous"><parent link="base_link"/><child link="left_wheel"/><origin xyz="0 0.5 0.2" rpy="-1.5708 0 0"/><axis xyz="0 0 1"/><limit effort="300" velocity="20"/><dynamics damping="1.0" friction="0.1"/></joint>
<link name="right_wheel"><inertial><origin xyz="0 0 0"/><mass value="3.0"/><inertia ixx="0.0325" iyy="0.0325" izz="0.06" ixy="0" ixz="0" iyz="0"/></inertial><visual><origin xyz="0 0 0"/><geometry><cylinder radius="0.2" length="0.1"/></geometry><material name="m_right_wheel"><color rgba="0.1 0.1 0.1 1"/></material></visual><collision><origin xyz="0 0 0"/><geometry><cylinder radius="0.2" length="0.1"/></geometry></collision></link>
<joint name="right_wheel_joint" type="continuous"><parent link="base_link"/><child link="right_wheel"/><origin xyz="0 -0.5 0.2" rpy="-1.5708 0 0"/><axis xyz="0 0 1"/><limit effort="300" velocity="20"/><dynamics damping="1.0" friction="0.1"/></joint>
<link name="front_caster"><inertial><origin xyz="0 0 0"/><mass value="0.5"/><inertia ixx="0.002" iyy="0.002" izz="0.002" ixy="0" ixz="0" iyz="0"/></inertial><visual><origin xyz="0 0 0"/><geometry><sphere radius="0.1"/></geometry><material name="m_front_caster"><color rgba="0.2 0.2 0.2 1"/></material></visual><collision><origin xyz="0 0 0"/><geometry><sphere radius="0.1"/></geometry></collision></link>
<joint name="front_caster_joint" type="fixed"><parent link="base_link"/><child link="front_caster"/><origin xyz="0.45 0 0.1" rpy="0 0 0"/></joint>
<link name="rear_caster"><inertial><origin xyz="0 0 0"/><mass value="0.5"/><inertia ixx="0.002" iyy="0.002" izz="0.002" ixy="0" ixz="0" iyz="0"/></inertial><visual><origin xyz="0 0 0"/><geometry><sphere radius="0.1"/></geometry><material name="m_rear_caster"><color rgba="0.2 0.2 0.2 1"/></material></visual><collision><origin xyz="0 0 0"/><geometry><sphere radius="0.1"/></geometry></collision></link>
<joint name="rear_caster_joint" type="fixed"><parent link="base_link"/><child link="rear_caster"/><origin xyz="-0.45 0 0.1" rpy="0 0 0"/></joint>
<link name="blade"><inertial><origin xyz="0 0 0"/><mass value="5.0"/><inertia ixx="0.666667" iyy="0.0677083" izz="0.601042" ixy="0" ixz="0" iyz="0"/></inertial><visual><origin xyz="0 0 0"/><geometry><box size="0.05 1.2 0.4"/></geometry><material name="m_blade"><color rgba="0.8 0.2 0.1 1"/></material></visual><collision><origin xyz="0 0 0"/><geometry><box size="0.05 1.2 0.4"/></geometry></collision></link>
<joint name="blade_joint" type="prismatic"><parent link="base_link"/><child link="blade"/><origin xyz="0.75 0 0.4" rpy="0 0 0"/><axis xyz="0 0 1"/><limit lower="-0.18" upper="0" effort="1000.0" velocity="0.3"/><dynamics damping="1.0" friction="0.1"/></joint>
<link name="turret"><inertial><origin xyz="0 0 0.125"/><mass value="6.0"/><inertia ixx="0.065" iyy="0.065" izz="0.0675" ixy="0" ixz="0" iyz="0"/></inertial><visual><origin xyz="0 0 0.125"/><geometry><cylinder radius="0.15" length="0.25"/></geometry><material name="m_turret"><color rgba="0.3 0.3 0.35 1"/></material></visual></link>
<joint name="turret_joint" type="revolute"><parent link="base_link"/><child link="turret"/><origin xyz="0 0 0.5" rpy="0 0 0"/><axis xyz="0 0 1"/><limit lower="-3.14159" upper="3.14159" effort="500.0" velocity="1.5"/><dynamics damping="1.0" friction="0.1"/></joint>
<link name="upper_arm"><inertial><origin xyz="0.55 0 0"/><mass value="4.0"/><inertia ixx="0.0096" iyy="0.408133" izz="0.408133" ixy="0" ixz="0" iyz="0"/></inertial><visual><origin xyz="0.55 0 0"/><geometry><box size="1.1 0.12 0.12"/></geometry><material name="m_upper_arm"><color rgba="0.9 0.65 0.1 1"/></material></visual></link>
<joint name="shoulder_joint" type="revolute"><parent link="turret"/><child link="upper_arm"/><origin xyz="0 0 0.25" rpy="0 0 0"/><axis xyz="0 1 0"/><limit lower="-1.8" upper="1.8" effort="800.0" velocity="1.0"/><dynamics damping="1.0" friction="0.1"/></joint>
<link name="forearm"><inertial><origin xyz="0.55 0 0"/><mass value="3.0"/><inertia ixx="0.0072" iyy="0.3061" izz="0.3061" ixy="0" ixz="0" iyz="0"/></inertial><visual><origin xyz="0.55 0 0"/><geometry><box size="1.1 0.12 0.12"/></geometry><material name="m_forearm"><color rgba="0.9 0.65 0.1 1"/></material></visual></link>
<joint name="elbow_joint" type="revolute"><parent link="upper_arm"/><child link="forearm"/><origin xyz="1.1 0 0" rpy="0 0 0"/><axis xyz="0 1 0"/><limit lower="0" upper="3" effort="500.0" velocity="1.0"/><dynamics damping="1.0" friction="0.1"/></joint>
<link name="wrist"><inertial><origin xyz="0 0 -0.025"/><mass value="1.0"/><inertia ixx="0.00354167" iyy="0.00770833" izz="0.0108333" ixy="0" ixz="0" iyz="0"/></inertial><visual><origin xyz="0 0 -0.025"/><geometry><box size="0.3 0.2 0.05"/></geometry><material name="m_wrist"><color rgba="0.25 0.25 0.3 1"/></material></visual><visual><origin xyz="0 0 -0.025"/><geometry><box size="0.15 1.18 0.035"/></geometry><material name="m_wrist_sub0"><color rgba="0.25 0.26 0.3 1"/></material></visual><visual><origin xyz="0.04 0 -0.042"/><geometry><box size="0.05 1.18 0.018"/></geometry><material name="m_wrist_sub1"><color rgba="0.55 0.6 0.68 1"/></material></visual><visual><origin xyz="-0.04 0 -0.042"/><geometry><box size="0.05 1.18 0.018"/></geometry><material name="m_wrist_sub2"><color rgba="0.55 0.6 0.68 1"/></material></visual></link>
<joint name="wrist_joint" type="revolute"><parent link="forearm"/><child link="wrist"/><origin xyz="1.1 0 0" rpy="0 0 0"/><axis xyz="0 1 0"/><limit lower="-3.14159" upper="3.14159" effort="100.0" velocity="2.0"/><dynamics damping="1.0" friction="0.1"/></joint>
<link name="finger_left"><inertial><origin xyz="0 0 0"/><mass value="0.5"/><inertia ixx="0.00170417" iyy="0.00541667" izz="0.0037875" ixy="0" ixz="0" iyz="0"/></inertial><visual><origin xyz="0 0 0"/><geometry><box size="0.3 0.03 0.2"/></geometry><material name="m_finger_left"><color rgba="0.15 0.15 0.15 1"/></material></visual><visual><origin xyz="0 0 0.125"/><geometry><box size="0.18 0.065 0.045"/></geometry><material name="m_finger_left_sub0"><color rgba="0.35 0.38 0.44 1"/></material></visual><visual><origin xyz="0 0 0.065"/><geometry><box size="0.22 0.038 0.075"/></geometry><material name="m_finger_left_sub1"><color rgba="0.18 0.2 0.24 1"/></material></visual><collision><origin xyz="0 0 0"/><geometry><box size="0.3 0.03 0.2"/></geometry></collision></link>
<joint name="finger_left_joint" type="prismatic"><parent link="wrist"/><child link="finger_left"/><origin xyz="0 0.065 -0.15" rpy="0 0 0"/><axis xyz="0 1 0"/><limit lower="0" upper="0.5" effort="200.0" velocity="0.5"/><dynamics damping="1.0" friction="0.1"/></joint>
<link name="finger_right"><inertial><origin xyz="0 0 0"/><mass value="0.5"/><inertia ixx="0.00170417" iyy="0.00541667" izz="0.0037875" ixy="0" ixz="0" iyz="0"/></inertial><visual><origin xyz="0 0 0"/><geometry><box size="0.3 0.03 0.2"/></geometry><material name="m_finger_right"><color rgba="0.15 0.15 0.15 1"/></material></visual><visual><origin xyz="0 0 0.125"/><geometry><box size="0.18 0.065 0.045"/></geometry><material name="m_finger_right_sub0"><color rgba="0.35 0.38 0.44 1"/></material></visual><visual><origin xyz="0 0 0.065"/><geometry><box size="0.22 0.038 0.075"/></geometry><material name="m_finger_right_sub1"><color rgba="0.18 0.2 0.24 1"/></material></visual><collision><origin xyz="0 0 0"/><geometry><box size="0.3 0.03 0.2"/></geometry></collision></link>
<joint name="finger_right_joint" type="prismatic"><parent link="wrist"/><child link="finger_right"/><origin xyz="0 -0.065 -0.15" rpy="0 0 0"/><axis xyz="0 -1 0"/><limit lower="0" upper="0.5" effort="200.0" velocity="0.5"/><dynamics damping="1.0" friction="0.1"/></joint>
<gazebo reference="blade"><gravity>false</gravity></gazebo>
<gazebo reference="turret"><gravity>false</gravity></gazebo>
<gazebo reference="upper_arm"><gravity>false</gravity></gazebo>
<gazebo reference="forearm"><gravity>false</gravity></gazebo>
<gazebo reference="wrist"><gravity>false</gravity></gazebo>
<gazebo reference="finger_left"><gravity>false</gravity></gazebo>
<gazebo reference="finger_right"><gravity>false</gravity></gazebo>
<gazebo reference="left_wheel"><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>
<gazebo reference="right_wheel"><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>
<gazebo reference="front_caster"><mu1>0.01</mu1><mu2>0.01</mu2></gazebo>
<gazebo reference="rear_caster"><mu1>0.01</mu1><mu2>0.01</mu2></gazebo>
<gazebo reference="finger_left"><mu1>5.0</mu1><mu2>5.0</mu2></gazebo>
<gazebo reference="finger_right"><mu1>5.0</mu1><mu2>5.0</mu2></gazebo>
<gazebo><plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive"><left_joint>left_wheel_joint</left_joint><right_joint>right_wheel_joint</right_joint><wheel_separation>1.0</wheel_separation><wheel_radius>0.2</wheel_radius><max_linear_velocity>1.0</max_linear_velocity><max_angular_velocity>1.5</max_angular_velocity><topic>cmd_vel</topic><odom_topic>odom</odom_topic><tf_topic>tf</tf_topic><frame_id>odom</frame_id><child_frame_id>base_link</child_frame_id><odom_publish_frequency>30</odom_publish_frequency></plugin><plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher"><topic>joint_states</topic></plugin><plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController"><joint_name>turret_joint</joint_name><topic>cmd/turret</topic><p_gain>150.0</p_gain><i_gain>0</i_gain><d_gain>15.0</d_gain><cmd_max>500.0</cmd_max><cmd_min>-500.0</cmd_min></plugin><plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController"><joint_name>shoulder_joint</joint_name><topic>cmd/shoulder</topic><p_gain>150.0</p_gain><i_gain>0</i_gain><d_gain>15.0</d_gain><cmd_max>800.0</cmd_max><cmd_min>-800.0</cmd_min></plugin><plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController"><joint_name>elbow_joint</joint_name><topic>cmd/elbow</topic><p_gain>150.0</p_gain><i_gain>0</i_gain><d_gain>15.0</d_gain><cmd_max>500.0</cmd_max><cmd_min>-500.0</cmd_min></plugin><plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController"><joint_name>wrist_joint</joint_name><topic>cmd/wrist</topic><p_gain>150.0</p_gain><i_gain>0</i_gain><d_gain>15.0</d_gain><cmd_max>100.0</cmd_max><cmd_min>-100.0</cmd_min></plugin><plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController"><joint_name>finger_left_joint</joint_name><topic>cmd/finger</topic><p_gain>250.0</p_gain><i_gain>0</i_gain><d_gain>15.0</d_gain><cmd_max>200.0</cmd_max><cmd_min>-200.0</cmd_min></plugin><plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController"><joint_name>finger_right_joint</joint_name><topic>cmd/finger</topic><p_gain>250.0</p_gain><i_gain>0</i_gain><d_gain>15.0</d_gain><cmd_max>200.0</cmd_max><cmd_min>-200.0</cmd_min></plugin><plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController"><joint_name>blade_joint</joint_name><topic>cmd/blade</topic><p_gain>250.0</p_gain><i_gain>0</i_gain><d_gain>15.0</d_gain><cmd_max>1000.0</cmd_max><cmd_min>-1000.0</cmd_min></plugin></gazebo>
</robot>
